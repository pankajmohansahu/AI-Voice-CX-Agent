# Copy this file to .env.local and fill in your keys.
# All keys are server-side only — never prefix them with NEXT_PUBLIC_.

# LLM  — https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Speech-to-text  — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Text-to-speech  — https://dashboard.sarvam.ai
SARVAM_API_KEY=
TTS_MODEL=bulbul:v2
TTS_SPEAKER=anushka
